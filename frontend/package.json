{
  "name": "av-scenes-card",
  "version": "0.7.0",
  "private": true,
  "description": "Remote control card for the AV Scenes integration",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && esbuild src/av-scenes-card.ts --bundle --minify --format=esm --target=es2021 --legal-comments=none --outfile=../custom_components/av_scenes/frontend/av-scenes-card.js",
    "watch": "esbuild src/av-scenes-card.ts --bundle --format=esm --target=es2021 --watch --outfile=../custom_components/av_scenes/frontend/av-scenes-card.js"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  }
}
